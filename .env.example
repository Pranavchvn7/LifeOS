# Required on Vercel (Settings > Environment Variables)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-string-of-32+-characters   # openssl rand -hex 32
BETTER_AUTH_URL=https://your-app.vercel.app                         # your public URL (no trailing slash)

# Optional: extra trusted origins (custom domains), comma-separated
TRUSTED_ORIGINS=https://www.yourdomain.com
